# Preserve scientific artifacts without text conversion or merging.
*.pdf binary
*.png binary
*.npz binary
*.svg binary

# CSV writers use CRLF; retain the reference tables' original line endings.
*.csv whitespace=cr-at-eol

# HTML exports bundle generated plotting code and data.
notebooks/*.html binary linguist-generated=true
notebooks/geometry_debug_outputs/*.html binary linguist-generated=true
notebooks/geometry_debug_outputs/** linguist-generated=true
notebooks/amplitude_debug_outputs/** linguist-generated=true
notebooks/gamma_p_outputs/** linguist-generated=true
